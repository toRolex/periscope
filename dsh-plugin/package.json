{
  "name": "periscope-dsh",
  "version": "0.1.0",
  "description": "periscope 的 dsh（deepseek-harness）原生插件包 —— periscope-deepseek route 桥（声明 image 能力、纯文本委托 deepseek）+ describe 引擎副本；与主仓同构的零依赖 tsc && node --test",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/bridge/plugin.js",
  "bin": {
    "periscope-dsh-snippet": "./dist/snippet/cli.js"
  },
  "exports": {
    ".": "./dist/bridge/plugin.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test 'dist/**/*.test.js'",
    "snippet": "node dist/snippet/cli.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.2.0",
    "react": "18.2.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
